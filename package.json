{
  "name": "32-htl-website-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable hot tub / spa store website template. One config file drives every client site.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "client:use": "node scripts/use-client.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:apply:local": "echo 'DEPRECATED \u2014 use npm run db:migrate:local' && wrangler d1 execute DB --local --file=./db/schema.sql",
    "db:apply:remote": "echo 'DEPRECATED \u2014 use npm run db:migrate:remote' && wrangler d1 execute DB --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.example.sql",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --no-render",
    "gate:test": "node scripts/gate.test.mjs",
    "test:lib": "node --import ./tests/lib/register.mjs --test \"tests/lib/*.test.mjs\"",
    "deploy": "npm run build && npm run gate && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.1",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@nanostores/react": "^1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.1",
    "nanostores": "^1.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "8.2.1"
  }
}