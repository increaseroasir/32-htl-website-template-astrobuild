---
/**
 * PRIVACY POLICY.
 *
 * ┌──────────────────────────────────────────────────────────────────┐
 * │  THIS IS A STARTING POINT, NOT LEGAL ADVICE.                     │
 * │  Have the client's counsel review it before launch. What it does │
 * │  guarantee is ACCURACY: every disclosure below describes what    │
 * │  this codebase actually does, and the sections about third       │
 * │  parties appear only when that integration is switched on.       │
 * └──────────────────────────────────────────────────────────────────┘
 *
 * A privacy policy that claims you share data with Meta when you don't — or
 * worse, doesn't mention it when you do — is the wrong-not-broken defect with
 * regulatory consequences. So the integration sections are driven by the same
 * config flags that decide whether the code runs at all. Turn Meta off and
 * the Meta paragraph disappears, because it stopped being true.
 *
 * Required for Meta's pixel and Conversions API terms, and referenced by the
 * consent text on the lead form.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, derived } from '../config';

/**
 * A policy has to give people a way to reach you. Rendered as real links, not
 * as text — the gate caught this file printing the number as plain prose,
 * which is the exact defect it was written to catch. On a phone, an
 * unclickable number is a number nobody calls.
 */
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${site.identity.name} collects, uses and shares information from this website.`}
  path="/privacy-policy"
>
  <div class="wrap pp">
    <Breadcrumbs trail={[{ label: 'Privacy Policy', href: '/privacy-policy' }]} />

    <h1>Privacy Policy</h1>
    <p class="pp-lede">
      This policy explains what {site.identity.name} collects through this website, why, and who
      it is shared with.
    </p>

    <h2>Who we are</h2>
    <p>
      {site.identity.name}, {derived.addressOneLine}. You can reach us at{' '}
      {site.contact.email && (<><a href={derived.emailHref!}>{site.contact.email}</a> or </>)}
      <a href={derived.telHref}>{derived.phoneDisplay}</a>.
    </p>

    <h2>What we collect</h2>
    <p>When you submit a form on this site, we collect:</p>
    <ul>
      <li>Your name, phone number and email address</li>
      <li>Anything you type into the message field</li>
      <li>Which product category or product you were looking at</li>
      <li>The page you submitted from</li>
    </ul>
    <p>
      We also record, automatically, information about how you arrived: the campaign or link
      that referred you, your IP address, and your browser's user agent. This is stored both as
      first touch (how you first found us) and last touch (how you arrived most recently).
    </p>

    <h2>Cookies</h2>
    <p>
      We set a small number of first-party cookies. One identifies your session so that a repeat
      form submission updates your existing enquiry rather than creating a duplicate. The others
      remember which campaign or search brought you here, so we can tell which advertising is
      working. They contain no name, email or phone number.
    </p>
    {
      site.integrations.meta.enabled && (
        <p>
          Meta also sets cookies on this site (<code>_fbp</code> and <code>_fbc</code>) to
          measure the performance of advertising.
        </p>
      )
    }

    <h2>How we use it</h2>
    <ul>
      <li>To respond to your enquiry — by phone, text or email</li>
      <li>To send you pricing and availability for what you asked about</li>
      <li>To understand which advertising brings us genuine enquiries</li>
    </ul>
    <p>
      By submitting a form you agree that we may contact you about your enquiry, including with
      automated messages. Consent is not a condition of purchase, and you can opt out of text
      messages at any time by replying STOP.
    </p>

    <h2>Who we share it with</h2>
    <p>We do not sell your personal information. We share it with:</p>
    <ul>
      {
        site.integrations.ghl.enabled && (
          <li>
            <strong>Our customer relationship system</strong> — your contact details and enquiry
            are stored there so our team can follow up.
          </li>
        )
      }
      {
        site.integrations.meta.enabled && (
          <li>
            <strong>Meta (Facebook and Instagram)</strong> — we send a record that an enquiry
            happened, so advertising can be measured. Your email, phone number and name are
            irreversibly hashed before they leave our server; Meta receives the hash, never the
            values themselves.
          </li>
        )
      }
      {
        site.integrations.zaraz.enabled && (
          <li>
            <strong>Cloudflare Zaraz</strong> — loads and manages the measurement tags described
            above.
          </li>
        )
      }
      {
        site.integrations.sentry.enabled && (
          <li>
            <strong>Our error monitoring provider</strong> — receives technical details when
            something on the site fails, so we can fix it.
          </li>
        )
      }
      <li>
        <strong>Cloudflare</strong> — hosts this website and stores the information you submit.
      </li>
    </ul>

    <h2>How long we keep it</h2>
    <p>
      Enquiries are kept for as long as we may reasonably need them to serve you, and to meet our
      record-keeping obligations. Attribution cookies expire well within a year.
    </p>

    <h2>Your choices</h2>
    <p>
      You can ask us what we hold about you, ask us to correct it, or ask us to delete it.
      Contact us at{' '}
      {site.contact.email && (<><a href={derived.emailHref!}>{site.contact.email}</a> or </>)}
      <a href={derived.telHref}>{derived.phoneDisplay}</a> and we will respond. You can also
      block or delete cookies in your browser settings, though parts of the site may not work as
      intended afterwards.
    </p>

    <h2>Children</h2>
    <p>
      This site is not directed at children, and we do not knowingly collect information from
      anyone under 16.
    </p>

    <h2>Changes</h2>
    <p>
      If this policy changes we will update this page. Continuing to use the site after a change
      means you accept the updated policy.
    </p>

    <p class="pp-contact">
      Questions about any of this:{' '}
      {site.contact.email && (<><a href={derived.emailHref!}>{site.contact.email}</a> or </>)}
      <a href={derived.telHref}>{derived.phoneDisplay}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .pp {
    max-width: 46rem;
    padding: 1.5rem 0 4rem;
  }
  .pp h1 {
    font-family: var(--brand-font-display);
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 0.75rem 0 0;
  }
  .pp-lede {
    color: var(--brand-ink-muted);
    font-size: 1.05rem;
  }
  .pp h2 {
    font-family: var(--brand-font-display);
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
  }
  .pp p,
  .pp li {
    line-height: 1.65;
  }
  .pp ul {
    padding-left: 1.15rem;
  }
  .pp li {
    margin: 0.35rem 0;
  }
  .pp code {
    background: var(--brand-surface-alt);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-family: var(--brand-font-mono);
    font-size: 0.9em;
  }
  .pp-contact {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-deep) 12%, transparent);
  }
</style>
