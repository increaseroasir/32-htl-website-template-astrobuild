---
/**
 * HOMEPAGE.
 *
 * Almost nothing here. The page is an ordered list of sections in
 * src/config/homepage.config.ts, rendered by the shared section renderer —
 * the same one every paid landing page uses.
 *
 * That is the point: client #2's homepage is a different arrangement of the
 * same blocks, not a rebuilt page. And because no section may hold a fact
 * that already lives in client.config.ts, the phone number, address, hours,
 * years-in-business and product list are read at render time and cannot go
 * stale in a copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Render from '../components/sections/Render.astro';
import { site } from '../config';
import { collectFootnotes } from '../config/sections.schema';

// The homepage is part of the ONE config file. There is no second place.
const homepage = site.homepage;

const footnotes = collectFootnotes(homepage.sections);

/**
 * Structured data. AggregateRating comes from the SAME reviews section that
 * renders the visible "rated X across N" line, so the number a customer reads
 * and the number Google reads cannot disagree.
 */
const reviews = homepage.sections.find((s) => s.type === 'reviews');
const aggregate = reviews && reviews.type === 'reviews' ? reviews.aggregate : null;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.identity.name,
  url: site.identity.siteUrl,
  ...(aggregate
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: aggregate.rating,
          reviewCount: aggregate.count,
        },
      }
    : {}),
};
---

<BaseLayout
  title={homepage.title ?? site.identity.tagline}
  description={homepage.description ?? site.identity.tagline}
  path="/"
  jsonLd={jsonLd}
>
  <Render sections={homepage.sections} sourcePage="/" />

  {
    (footnotes.length > 0 || homepage.disclosures.length > 0) && (
      <section class="hp-disclosures wrap">
        {footnotes.length > 0 && (
          <ol class="hp-footnotes">
            {footnotes.map((f) => (
              <li>{f}</li>
            ))}
          </ol>
        )}
        {homepage.disclosures.map((d) => (
          <p class="hp-disclosure">{d}</p>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .hp-disclosures {
    padding: 1.5rem 0 2.5rem;
    max-width: 46rem;
  }
  .hp-footnotes {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--brand-ink-muted);
  }
  .hp-disclosure {
    margin: 0.4rem 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--brand-ink-muted);
  }
</style>
